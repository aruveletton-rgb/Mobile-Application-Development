{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "pages": "$profile:main_pages",
    "requestPermissions": [{ "name": "ohos.permission.INTERNET" }, { "name": "ohos.permission.PUBLISH_AGENT_REMINDER", "reason": "$string:reminder_reason", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }],
    "extensionAbilities": [{ "name": "CampusFormAbility", "srcEntry": "./ets/formability/CampusFormAbility.ets", "type": "form", "label": "$string:app_name", "description": "$string:module_desc", "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:form_config" }] }],
    "abilities": [{
      "name": "EntryAbility",
      "srcEntry": "./ets/entryability/EntryAbility.ets",
      "description": "$string:entry_desc",
      "icon": "$media:app_icon",
      "label": "$string:app_name",
      "startWindowIcon": "$media:app_icon",
      "startWindowBackground": "$color:start_window_background",
      "exported": true,
      "skills": [{ "entities": ["entity.system.home"], "actions": ["action.system.home"] }]
    }]
  }
}
